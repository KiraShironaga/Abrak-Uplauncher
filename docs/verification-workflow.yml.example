name: Verification
on: [push, pull_request]
permissions:
  contents: read
jobs:
  windows:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '24'
          cache: npm
          cache-dependency-path: |
            package-lock.json
            source/app/package-lock.json
      - run: npm ci
      - run: npm run setup
      - run: npm test
      - run: npm run verify
      - run: npm run build
      - run: npm run check:publication
